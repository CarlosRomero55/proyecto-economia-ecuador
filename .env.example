# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.
# Llave gratuita de https://comtradeplus.un.org (My Account > Subscriptions > comtrade - v1)
COMTRADE_SUBSCRIPTION_KEY=
# Opcional: solo se usa si falla la descarga del Pink Sheet (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=
# Servidor SQL Server local (prueba también localhost\SQLEXPRESS)
SQL_SERVER=localhost
SQL_DATABASE=EcuadorMonitor
# Opcional: URL del Pink Sheet mensual del Banco Mundial (cambia cada año; ver docs/adr/0005)
PINK_SHEET_URL=
